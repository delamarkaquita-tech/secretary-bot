# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key from https://aistudio.google.com/apikey
# Required unless every task below is routed to a local provider.
GEMINI_API_KEY=

# Gemini model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# ─── AI providers ─────────────────────────────────────────────────────────────
# Which backend handles each job. Defaults to gemini everywhere, so leaving all of
# this unset keeps the original cloud behaviour exactly as it was.
#
#   gemini  — Google Gemini API (cloud)
#   ollama  — a local model served by Ollama (https://ollama.com)
#
# AI_PROVIDER sets all three at once; the per-task vars override it individually.
# AI_PROVIDER=gemini

# chat       — the replies real people receive, sent as you. Quality matters most
#              here, and it is where local models are weakest on non-English.
# admin      — parsing your own DM commands into JSON. Local models do this well,
#              because Ollama constrains decoding with format:"json".
# transcribe — voice notes. Ollama CANNOT do speech-to-text; use gemini or whisper.
# AI_PROVIDER_CHAT=gemini
# AI_PROVIDER_ADMIN=ollama
# AI_PROVIDER_TRANSCRIBE=gemini

# ─── Ollama (local chat) ──────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_NUM_CTX=8192
# How long the model stays resident in VRAM. A cold load costs 5-15s, which would
# blow through the natural-pacing gap and make the bot feel laggy.
# OLLAMA_KEEP_ALIVE=30m

# ─── Whisper (local voice notes) ──────────────────────────────────────────────
# Only needed for AI_PROVIDER_TRANSCRIBE=whisper. Any server exposing the
# OpenAI-compatible /v1/audio/transcriptions endpoint works: whisper.cpp's
# whisper-server, faster-whisper-server, Speaches, or LocalAI.
# WHISPER_BASE_URL=http://localhost:8080/v1
# WHISPER_MODEL=whisper-1
# Pin the language for better accuracy on short clips; leave unset to autodetect.
# WHISPER_LANGUAGE=uz

# Your Telegram numeric user ID (used to notify you). Get it from @userinfobot
OWNER_USER_ID=

# IANA timezone used to ground "what time/day is it" answers. Defaults to Asia/Tashkent.
OWNER_TIMEZONE=Asia/Tashkent

# Natural reply pacing: show "typing…" and delay replies proportional to length.
# Set to false to reply instantly. Defaults to true.
NATURAL_TYPING=true

# Persona / instructions for the model. Keep it on a single line.
SYSTEM_PROMPT=You ARE Doston Sulaymon, personally replying to your own Telegram messages. Write as yourself in the first person — never refer to "Doston" in the third person, and never say or imply you are a bot, assistant, or AI. Keep it warm, casual, and short, like a real text. Never invent commitments, prices, plans, or facts you're unsure of — if you don't know something, say you'll check and get back to them, the way you naturally would. Match the sender's language.
